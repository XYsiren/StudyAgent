# 与 cook_c8 相同的本机模型。基础设施请按自己的端口/密码填写。
RAG_ENVIRONMENT=development
RAG_DATA_DIR=./data
RAG_DATABASE_URL=sqlite:///./data/rag.db
RAG_SECRET_KEY=development-only-change-this-secret-before-production
RAG_LLM_PROVIDER=ollama
RAG_LLM_BASE_URL=http://127.0.0.1:11434
RAG_LLM_MODEL=qwen3.5:9b
RAG_LLM_API_KEY=ollama
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434
RAG_EMBEDDING_MODEL=qwen3-embedding:8b
RAG_EMBEDDING_DIMENSION=4096
RAG_EMBEDDING_BATCH_SIZE=8
RAG_EMBEDDING_NUM_CTX=4096
RAG_OLLAMA_NUM_CTX=16384
RAG_MAX_OUTPUT_TOKENS=2048
RAG_MODEL_TIMEOUT=240
RAG_QDRANT_COLLECTION_PREFIX=rag_assistant
# 本机 Qwen3.5 支持图像输入；也可换为独立的 Qwen-VL。
RAG_VISION_MODEL=qwen3.5:9b
RAG_OCR_ENABLED=false
# 可选：cook_c8 使用的多语言 Cross-Encoder。首次使用需要下载权重。
# RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# RAG_QDRANT_URL=http://127.0.0.1:6335
# RAG_REDIS_URL=redis://127.0.0.1:6379/6
